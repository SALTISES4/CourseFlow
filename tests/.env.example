# Copy to tests/.env — loaded by tests/playwright.config.ts
# Requires: Vite on :3000, Django on :8000 pointed at courseflow_e2e (just django-run-e2e)

# Primary non-admin E2E actor created by `just django-seed-e2e-tests`
TEST_USERNAME=teacher@courseflow.com
TEST_PASSWORD=password

# Frontend origin (optional — default in playwright.config.ts is http://localhost:3000/)
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# Django API origin for authenticated direct API helpers (default shown below).
# Keep this aligned with react/.env VITE_API_BASE_URL.
# PLAYWRIGHT_API_BASE_URL=http://127.0.0.1:8000

# Workflow graph route for section E2E (optional — manifest from `just e2e-prepare` is used by default).
# PLAYWRIGHT_WORKFLOW_PATH=/workflow/<graph-uuid>/graph
