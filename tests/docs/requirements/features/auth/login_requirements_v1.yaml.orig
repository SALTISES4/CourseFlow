documentPreconditions:
  - user is not authenticated to CourseFlow
  - routes '/login/', '/register/', and '/password-reset' are publicly accessible without authentication

uiObjectDefinitions:
  loginPage:
    meaning: Public full-page sign-in experience at route '/login/' accessible without authentication.
  loginForm:
    meaning: Form container on loginPage for sign-in fields.
  brandLockup:
    meaning: Canonical definition in tests/docs/requirements/features/navigation/main_navigation_requirements_v1.yaml.
  loginTitle:
    meaning: Page title on loginPage labeled 'Login to CourseFlow'.
  loginEmailField:
<<<<<<< .merge_file_kHYkV5
