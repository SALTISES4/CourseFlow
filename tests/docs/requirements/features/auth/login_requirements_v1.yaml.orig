requirements:
  - id: FR-LOGIN-001
    title: Login route and primary form elements

    designEvidence:
      - FIGMA-LOGIN
      - FIGMA-LOGIN-FORGOT-PASSWORD

    actors:
      - user

    uiObjects:
      - loginPage
      - loginForm
      - loginTitle
      - brandLockup
      - loginEmailField
      - loginPasswordField
      - loginForgotPasswordLink
      - loginSubmitButton
      - loginRegisterPrompt
      - loginRegisterLink
      - loginFieldValidationMessage

    preconditions:
      - documentPreconditions for this file hold
      - user has not yet interacted with loginEmailField or loginPasswordField

    trigger:
      - user navigates to '/login/'

    mainFlow:
      - system intercepts navigation and verifies unauthenticated status
      - system renders loginPage matching loginForm layout constraints
      - system initializes loginEmailField and loginPasswordField with empty values
      - system initializes loginSubmitButton in a disabled state

    roleBehavior: {}

    acceptanceCriteria:
      - given user is not authenticated, current route matches '/login/' and loginPage is visible
      - given user is authenticated and user navigates to '/login/', current route matches '/home' and loginPage is not visible
      - loginForm is visible
      - loginForm contains and renders the following child components in a strict, top-to-bottom vertical layout sequence: brandLockup, loginTitle, loginEmailField, loginPasswordField, loginForgotPasswordLink, loginSubmitButton and loginRegisterPrompt + loginRegisterLink rendered inline as a adjacent pair
      - loginEmailField value is empty
      - loginPasswordField value is empty
      - loginSubmitButton is disabled

    openQuestions: []

  - id: FR-LOGIN-002
    title: Login page external link navigation
    
    designEvidence:
      - FIGMA-LOGIN
    
    actors:
      - user

    uiObjects:
      - loginPage
      - loginForgotPasswordLink
      - loginRegisterLink

    preconditions:
      - current route matches '/login/' and loginPage is visible

    trigger:
      - user clicks loginForgotPasswordLink or loginRegisterLink

    mainFlow:
      - given user clicks loginForgotPasswordLink, system routes to public forgotPasswordPage at '/password-reset' per tests/docs/requirements/original/forgot_password_requirements_v1.yaml FR-FPWD-001; distinct from authenticated change-password at '/user/password-reset' per tests/docs/requirements/original/password_reset_requirements_v1.yaml
      - given user clicks loginRegisterLink, system routes to '/register/'

    roleBehavior: {}

    acceptanceCriteria:
      - given user clicks loginForgotPasswordLink, then current route matches '/password-reset'
      - given user clicks loginRegisterLink, then current route matches '/register/'

    openQuestions: []

  - id: FR-LOGIN-003
    title: Login field validation rules

    designEvidence:
      - FIGMA-LOGIN

    actors:
      - user

    uiObjects:
      - loginForm
      - loginEmailField
      - loginPasswordField
      - loginFieldValidationMessage
      - loginSubmitButton

    preconditions:
      - documentPreconditions for this file hold
      - loginForm is visible

    trigger:
      - user changes loginForm field content

    mainFlow:
      - all loginForm input fields are mandatory; user cannot submit loginForm with any required field empty or invalid
      - loginEmailField requires a non-empty valid email address with at least one character before '@' and a domain name after '@'
      - given loginEmailField value is non-empty but not a valid email address after interaction, loginFieldValidationMessage is visible with text 'Invalid email format' for loginEmailField and loginSubmitButton is disabled and not clickable
      - loginPasswordField requires a non-empty value
      - given user enters a value in loginPasswordField, loginPasswordField masks the entered characters (native secret input)
      - validation for loginForm fields starts after user interaction with the relevant field and runs before user clicks loginSubmitButton
      - loginSubmitButton is disabled and not clickable until loginEmailField and loginPasswordField are valid per this requirement
      - when all loginForm fields are valid, loginSubmitButton becomes enabled and clickable
      - given loginFieldValidationMessage is visible for a loginForm field and the user corrects that field to a valid value, loginFieldValidationMessage is not visible for that field
      - given validation fails for a loginForm field, loginFieldValidationMessage is visible on the invalid field, loginSubmitButton is disabled and not clickable, and loginForm is not submitted while invalid values remain

    roleBehavior: {}

    acceptanceCriteria:
      - given user clears loginEmailField after interaction, loginFieldValidationMessage is visible with text 'Email is required' for loginEmailField
      - given loginEmailField value is non-empty but not a valid email address after interaction, loginFieldValidationMessage is visible with text 'Invalid email format' for loginEmailField
      - given loginEmailField value is non-empty but not a valid email address, loginSubmitButton is disabled and not clickable
      - given user clears loginPasswordField after interaction, loginFieldValidationMessage is visible with text 'Password is required' for loginPasswordField
      - given user enters a value in loginPasswordField, loginPasswordField masks the entered characters (native secret input)
      - given any loginForm field is empty or invalid, loginSubmitButton is disabled and not clickable
      - given loginFieldValidationMessage is visible for loginEmailField and user then enters a valid email address, loginFieldValidationMessage is not visible for loginEmailField
      - given loginFieldValidationMessage is visible for loginPasswordField with text 'Password is required' and user then enters a non-empty value, loginFieldValidationMessage is not visible for loginPasswordField
      - given all loginForm fields are valid, loginSubmitButton is enabled and clickable

    openQuestions: []

  - id: FR-LOGIN-004
    title: Failed login with invalid credentials

    designEvidence:
      - FIGMA-LOGIN
      - FIGMA-LOGIN-CREDENTIALS-ERROR

    actors:
      - user

    uiObjects:
      - loginPage
      - loginTitle
      - loginForm
      - loginEmailField
      - loginPasswordField
      - loginForgotPasswordLink
      - loginSubmitButton
      - loginRegisterPrompt
      - loginRegisterLink
      - loginAuthenticationErrorMessage

    preconditions:
      - documentPreconditions for this file hold
      - loginForm is visible
      - user has filled loginEmailField and loginPasswordField with valid values

    trigger:
      - user clicks loginSubmitButton with valid loginEmailField and loginPasswordField that do not match an existing account

    mainFlow:
      - given user clicks loginSubmitButton with valid loginForm values that do not match an existing account, login fails
      - given login fails, user remains on loginPage and is not authenticated to CourseFlow
      - given login fails, loginForm remains visible with loginEmailField and loginPasswordField retaining the submitted values
      - given login fails with a valid loginForm, loginSubmitButton is enabled and clickable
      - given login fails, loginTitle, loginForgotPasswordLink, loginRegisterPrompt, and loginRegisterLink remain visible on loginPage
      - given login fails, loginAuthenticationErrorMessage is visible within the loginForm, between loginTitle and loginEmailField, with text 'The email or password you entered is incorrect. please check your details and try again.'
      - given login fails, current route remains '/login/'
      - given login fails and user then changes any loginForm field value, loginAuthenticationErrorMessage is hidden from view

    roleBehavior: {}

    acceptanceCriteria:
      - given user clicks loginSubmitButton with valid loginForm values that do not match an existing account, login fails
      - given login fails, user is not authenticated to CourseFlow
      - given login fails, current route matches '/login/'
      - given login fails, loginForm shows loginTitle, loginAuthenticationErrorMessage, loginEmailField, loginPasswordField, loginForgotPasswordLink, loginSubmitButton and the loginRegisterPrompt and loginRegisterLink combo in that order
      - given login fails, loginAuthenticationErrorMessage is visible with text 'The email or password you entered is incorrect. please check your details and try again.'
      - given login fails, loginEmailField and loginPasswordField retain the values submitted on the failed attempt
      - given login fails with a valid loginForm, loginSubmitButton remains enabled and clickable
      - given login fails and user then changes any loginForm field value, loginAuthenticationErrorMessage is hidden from view

    openQuestions: []

  - id: FR-LOGIN-005
    title: Successful login and redirect to 'Home'

    designEvidence:
      - FIGMA-LOGIN

    actors:
      - user

    uiObjects:
      - loginPage
      - loginForm
      - loginEmailField
      - loginPasswordField
      - loginSubmitButton
      - homePage

    preconditions:
      - documentPreconditions for this file hold
      - loginForm is visible
      - loginForm is valid
      - valid loginForm values match an existing account

    trigger:
      - user changes loginForm content and clicks loginSubmitButton

    mainFlow:
      - given user clicks loginSubmitButton with valid loginForm values that match an existing account, user is authenticated to CourseFlow
      - given login succeeds, application navigates immediately to route '/home' with no interim confirmation copy or snackbar on loginPage
      - given login succeeds, homePage is visible

    roleBehavior: {}

    acceptanceCriteria:
      - given user clicks loginSubmitButton with valid loginForm values that match an existing account, login succeeds
      - given login succeeds, user is authenticated to CourseFlow
      - given login succeeds, application navigates immediately to '/home' with no interim confirmation copy or snackbar
      - given login succeeds, current route matches '/home'
      - given login succeeds, homePage is visible per tests/docs/requirements/features/home/homepage_requirements_v1.yaml FR-HOME-001

    openQuestions: []

