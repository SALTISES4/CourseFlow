  loginForgotPasswordLink: "canonical_locators.yaml -> loginForgotPasswordLink"
  loginRegisterPrompt: "canonical_locators.yaml -> loginRegisterPrompt"
  loginRegisterLink: "canonical_locators.yaml -> loginRegisterLink"
