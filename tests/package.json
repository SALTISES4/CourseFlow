{
  "name": "courseflow",
  "version": "1.0.0",
  "homepage": "https://github.com/SALTISES4/CourseFlow#readme",
  "description": "https://circleci.com/gh/SALTISES4/CourseFlow",
  "main": "index.js",
  "directories": {
    "doc": "../docs",
    "test": "test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "^25.5.2",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.4.2"
  },
  "scripts": {
    "test": "yarn allure:clean && playwright test",
    "test-setup": "yarn allure:clean && playwright test --project=setup",
    "test-ui": "yarn allure:clean && playwright test --ui",
    "test-ui:last-failed": "yarn allure:clean && playwright test --ui --last-failed",
    "test-debug": "yarn allure:clean && playwright test --debug",
    "test-headed": "yarn allure:clean && playwright test --headed",
    "test-report": "playwright show-report",
    "test:e2e:failed": "yarn allure:clean && playwright test --last-failed",
    "test-list": "playwright test --list",
    "allure:clean": "rm -rf allure-results allure-report",
    "allure:test": "yarn test",
    "allure:generate": "rm -rf allure-report && allure generate allure-results --output allure-report",
    "allure:open": "allure open allure-report"
  },
  "volta": {
    "node": "24.14.1",
    "yarn": "1.22.22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SALTISES4/CourseFlow.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/SALTISES4/CourseFlow/issues"
  },
  "dependencies": {
    "@playwright/cli": "^0.1.6",
    "allure": "^3.14.3"
  }
}
