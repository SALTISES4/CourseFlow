# Runtime environment name. DigitalOcean UAT uses uat; AWS staging uses staging.
ENV=development

# Used by Docker Compose for the postgres service (copy to .env and adjust).
POSTGRES_DB=courseflow
POSTGRES_USER=courseflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Django on the host connects to that container via localhost.
POSTGRES_HOST=127.0.0.1

# Optional (course_flow/settings.py)
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Transactional email. Action links must use an HTTPS frontend origin whenever
# ENV is not development. The sender must be authorized by the delivery backend.
# Local development sends SMTP to the Mailpit service started by `just docker::up`.
# Its inbox is available at http://127.0.0.1:8025.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=127.0.0.1
# EMAIL_PORT=1025
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=false
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=10
# MAILPIT_SMTP_PORT=1025
# MAILPIT_HTTP_PORT=8025
# DEFAULT_FROM_EMAIL=webmaster@localhost
# COURSEFLOW_SUPPORT_EMAIL=admin@courseflow.com
# COURSEFLOW_FRONTEND_URL=http://localhost:3000
# Keep false outside local/test environments; it permits HTTP action links.
# COURSEFLOW_ALLOW_INSECURE_EMAIL_ACTION_URLS=true
# PASSWORD_RESET_TIMEOUT=86400
# PASSWORD_RESET_RATE_LIMIT_SECRET=
# AWS_SES_REGION_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Django container (docker compose --profile uat)
# DJANGO_PORT=8000
# Set DJANGO_ALLOWED_HOSTS to include your UAT hostname, e.g. uat.example.com
# CORS_ALLOWED_ORIGINS=https://uat.example.com

# Required UAT reset fingerprint; repeat the managed POSTGRES_HOST and POSTGRES_DB.
# UAT_DATABASE_RESET_HOST=managed-postgres.example
# UAT_DATABASE_RESET_NAME=courseflow_uat

# Comma-separated browser origins allowed to call the API from another host/port (CORS).
# Default in settings includes common Vite dev ports; override in production.
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://uat.example.com
# CORS_ALLOWED_ORIGINS=
# Trust the first X-Forwarded-For address only behind a managed trusted proxy.
# COURSEFLOW_TRUST_PROXY_CLIENT_IP=false
