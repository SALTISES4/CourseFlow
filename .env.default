# Used by Docker Compose for the postgres service (copy to .env and adjust).
POSTGRES_DB=courseflow
POSTGRES_USER=courseflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Django on the host connects to that container via localhost.
POSTGRES_HOST=127.0.0.1

# Optional (course_flow/settings.py)
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated browser origins allowed to call the API from another host/port (CORS).
# Default in settings includes common Vite dev ports; override in production.
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
# CORS_ALLOWED_ORIGINS=
